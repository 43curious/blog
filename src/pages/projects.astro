---
import ContentGrid from '../components/ContentGrid.astro';
import PageHeader from '../components/PageHeader.astro';
import Layout from '../layouts/Layout.astro';
import { SITE_TITLE } from '../consts';

const projects = [
	{ name: 'TaldeBOT', url: 'https://taldebot.netlify.app/' },
	{ name: 'WaveSearch', url: 'https://github.com/43curious/wavesearch' },
	{ name: 'Iko-Connect', url: 'https://github.com/43curious/kablepatch' },
	{ name: 'tresna', url: 'https://tresna.vercel.app/' },
];
---

<Layout title={`Proyectos | ${SITE_TITLE}`} description="Proyectos y experimentos.">
	<ContentGrid>
		<PageHeader eyebrow="Trabajo" title="Proyectos" description="Proyectos y experimentos." />
		<section class="grid grid-cols-2 gap-4" aria-label="Galería de proyectos">
			{projects.map((project) => (
				<a
					href={project.url}
					class="group flex aspect-square flex-col justify-between border border-line bg-paper p-4 transition-colors duration-150 hover:bg-soft"
					target="_blank"
					rel="noreferrer"
				>
					<span class="self-end text-sm text-muted transition-transform duration-150 group-hover:-translate-y-0.5 group-hover:translate-x-0.5" aria-hidden="true">↗</span>
					<h2 class="text-xl font-semibold leading-tight text-ink md:text-2xl">{project.name}</h2>
				</a>
			))}
		</section>
	</ContentGrid>
</Layout>
