---
const applications = [
	{ package: 'zen', name: 'Zen', letter: 'Z' },
	{ package: 'iina', name: 'IINA', letter: 'I' },
	{ package: 'obs', name: 'OBS', letter: 'O' },
];
---

<figure class="declarative-demo" data-declarative-config data-listed="false" data-installed="false" data-change="none">
	<div class="demo-stage" aria-hidden="true">
		<div class="demo-half">
			<span class="half-label">Brewfile</span>
			<div class="content-stage">
				<div class="configuration-list">
					{applications.map((app) => (
						<div class="configuration-entry">
							<span class="entry-sign"></span><span>cask "{app.package}"</span>
						</div>
					))}
					<div class="configuration-entry changed-entry">
						<span class="entry-sign" data-change-sign></span><span class="entry-text">cask "blender"</span>
					</div>
					<span class="inventory-count" data-list-count>3 entradas</span>
				</div>
			</div>
		</div>
		<span class="demo-arrow">→</span>
		<div class="demo-half">
			<span class="half-label">Aplicaciones</span>
			<div class="content-stage dock-stage">
				<div class="dock-preview">
					<div class="dock">
						{applications.map((app) => (
							<div class="dock-slot" title={app.name}>
								<span class="dock-icon">{app.letter}</span>
							</div>
						))}
						<div class="dock-slot changed-slot" title="Blender">
							<span class="dock-icon">B</span>
						</div>
					</div>
					<span class="inventory-count" data-dock-count>3 aplicaciones</span>
				</div>
			</div>
		</div>
	</div>
	<figcaption>Añadir → instalar. Quitar → retirar al sincronizar con limpieza.</figcaption>
</figure>

<script>
	interface Frame {
		listed: boolean;
		installed: boolean;
		change: 'none' | 'add' | 'remove';
		duration: number;
	}

	// Edit the declaration first; reconcile the applications after a short, visible delay.
	const frames: Frame[] = [
		{ listed: false, installed: false, change: 'none', duration: 650 },
		{ listed: true, installed: false, change: 'add', duration: 550 },
		{ listed: true, installed: true, change: 'add', duration: 650 },
		{ listed: true, installed: true, change: 'none', duration: 1100 },
		{ listed: true, installed: true, change: 'remove', duration: 550 },
		{ listed: false, installed: true, change: 'remove', duration: 350 },
		{ listed: false, installed: false, change: 'remove', duration: 850 },
	];

	document.querySelectorAll<HTMLElement>('[data-declarative-config]').forEach((demo) => {
		const changeSign = demo.querySelector<HTMLElement>('[data-change-sign]');
		const listCount = demo.querySelector<HTMLElement>('[data-list-count]');
		const dockCount = demo.querySelector<HTMLElement>('[data-dock-count]');
		const motionPreference = window.matchMedia('(prefers-reduced-motion: reduce)');
		let frameIndex = 0;
		let timer: number | undefined;
		let inView = false;
		let playing = false;

		const render = (frame: Frame) => {
			demo.dataset.listed = String(frame.listed);
			demo.dataset.installed = String(frame.installed);
			demo.dataset.change = frame.change;
			if (changeSign) changeSign.textContent = frame.change === 'add' ? '+' : frame.change === 'remove' ? '−' : '';
			if (listCount) listCount.textContent = `${frame.listed ? 4 : 3} entradas`;
			if (dockCount) dockCount.textContent = `${frame.installed ? 4 : 3} aplicaciones`;
		};

		const advance = () => {
			const frame = frames[frameIndex];
			render(frame);
			frameIndex = (frameIndex + 1) % frames.length;
			timer = window.setTimeout(advance, frame.duration);
		};

		const updatePlayback = () => {
			if (!inView || document.hidden || motionPreference.matches) {
				window.clearTimeout(timer);
				playing = false;
				if (motionPreference.matches) {
					render({ listed: true, installed: true, change: 'none', duration: 0 });
					frameIndex = 0;
				}
			} else if (!playing) {
				playing = true;
				timer = window.setTimeout(advance, 350);
			}
		};

		const observer = new IntersectionObserver(([entry]) => {
			inView = entry.intersectionRatio >= 0.25;
			updatePlayback();
		}, { threshold: 0.25 });
		observer.observe(demo);
		motionPreference.addEventListener('change', updatePlayback);
		document.addEventListener('visibilitychange', updatePlayback);
	});
</script>

<style>
	.declarative-demo {
		--addition: light-dark(#15803d, #4ade80);
		--removal: light-dark(#b91c1c, #f87171);
		margin: 2rem 0;
		max-width: 48rem;
	}

	.demo-stage { position: relative; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); min-height: 16rem; }
	.demo-half { display: flex; min-width: 0; flex-direction: column; align-items: center; justify-content: center; gap: 1.5rem; padding: 1.5rem; }
	.half-label { color: var(--color-muted); font-size: 0.6rem; line-height: 1; letter-spacing: 0.12em; text-transform: uppercase; }
	.content-stage { display: flex; width: 100%; height: 9rem; align-items: center; justify-content: center; }
	.configuration-list { width: 100%; max-width: 13rem; }
	.configuration-entry { display: flex; height: 1.6rem; align-items: center; padding: 0.2rem 0.3rem; overflow: hidden; color: var(--color-muted); font-family: var(--font-mono); font-size: 0.8rem; line-height: 1.2rem; white-space: nowrap; }
	.entry-sign { flex: 0 0 1rem; }
	.changed-entry { height: 0; padding-block: 0; opacity: 0; transition: height 240ms ease, padding 240ms ease, opacity 240ms ease, background 180ms ease, color 180ms ease; }
	.declarative-demo[data-listed='true'] .changed-entry { height: 1.6rem; padding-block: 0.2rem; opacity: 1; }
	.declarative-demo[data-change='add'] .changed-entry { background: color-mix(in srgb, var(--addition) 10%, transparent); color: var(--addition); }
	.declarative-demo[data-change='remove'] .changed-entry { background: color-mix(in srgb, var(--removal) 10%, transparent); color: var(--removal); }
	.declarative-demo[data-change='remove'] .entry-text { text-decoration: line-through; }
	.inventory-count { display: block; margin-top: 0.65rem; color: var(--color-muted); font-size: 0.6rem; line-height: 1rem; }
	.configuration-list > .inventory-count { padding-left: 1.3rem; }
	.demo-arrow { position: absolute; top: calc(50% + 1rem); left: 50%; transform: translate(-50%, -50%); padding: 0.2rem; color: var(--color-muted); font-size: 1.2rem; line-height: 1; }
	.dock-preview { position: relative; }
	.dock-preview > .inventory-count { position: absolute; top: 100%; width: 100%; text-align: center; }

	.dock {
		--dock-size: clamp(1.15rem, 6vw, 2.15rem);
		--dock-gap: clamp(0.15rem, 0.6vw, 0.4rem);
		display: flex;
		padding: 0.6rem;
		border-radius: 0.6rem;
		background: var(--color-soft);
	}

	.dock-slot { display: flex; flex: none; width: calc(var(--dock-size) + var(--dock-gap)); height: var(--dock-size); align-items: center; justify-content: center; }
	.dock-icon { display: flex; flex: none; width: var(--dock-size); height: var(--dock-size); align-items: center; justify-content: center; border-radius: 0.25rem; background: var(--color-focus); color: #fff; font-family: var(--font-mono); font-size: clamp(0.65rem, 1.4vw, 0.85rem); line-height: 1; transition: background 180ms ease, color 180ms ease; }
	.changed-slot { width: 0; overflow: hidden; opacity: 0; transform: translateY(0.5rem) scale(0.8); transition: width 260ms ease, opacity 220ms ease, transform 260ms ease; }
	.declarative-demo[data-installed='true'] .changed-slot { width: calc(var(--dock-size) + var(--dock-gap)); opacity: 1; transform: translateY(0) scale(1); }
	.declarative-demo[data-change='add'] .changed-slot .dock-icon { background: var(--addition); color: var(--color-paper); }
	.declarative-demo[data-change='remove'] .changed-slot .dock-icon { background: var(--removal); color: var(--color-paper); }
	figcaption { margin-top: 0.65rem; color: var(--color-muted); font-size: 0.7rem; line-height: 1.6; }

	@media (max-width: 480px) {
		.demo-stage { min-height: 15rem; }
		.demo-half { gap: 1.25rem; padding: 1rem; }
		.configuration-entry { padding-inline: 0.2rem; font-size: 0.65rem; }
		.entry-sign { flex-basis: 0.75rem; }
		.configuration-list > .inventory-count { padding-left: 0.95rem; }
		.dock { padding: 0.4rem; }
	}

	@media (prefers-reduced-motion: reduce) {
		.changed-entry, .changed-slot, .dock-icon { transition: none; }
	}
</style>
