---
export interface ChartPoint {
	x: number | string;
	y: number;
	label?: string;
}

export interface ChartSeries {
	label: string;
	color?: string;
	values?: ChartPoint[];
	fn?: (x: number) => number;
	state?: 0 | 1;
}

type Mode = 'line' | 'curve' | 'scatter' | 'bar' | 'tower';

interface Props {
	mode?: Mode;
	title?: string;
	series: ChartSeries[];
	xDomain?: number[];
	yDomain?: number[];
	xLabel?: string;
	yLabel?: string;
	showGrid?: boolean;
	showPoints?: boolean;
	showTooltip?: boolean;
	animateOnScroll?: boolean;
	toggle?: {
		labels: string[];
		defaultState?: 0 | 1;
	};
}

const {
	mode = 'line',
	title,
	series,
	xDomain,
	yDomain,
	xLabel,
	yLabel,
	showGrid = true,
	showPoints = true,
	showTooltip = false,
	animateOnScroll = true,
	toggle,
} = Astro.props;

const width = 720;
const height = 360;
const padding = { top: 28, right: 20, bottom: 52, left: 58 };
const plotWidth = width - padding.left - padding.right;
const plotHeight = height - padding.top - padding.bottom;
const palette = ['#4137ff', '#e03131', '#008f5a', '#d9480f', '#0077ff', '#7048e8'];
const isBar = mode === 'bar' || mode === 'tower';
const initialToggleState = toggle?.defaultState ?? 0;

const finite = (value: number) => Number.isFinite(value);
const formatValue = (value: number) =>
	Number.isInteger(value) ? String(value) : value.toFixed(2).replace(/0+$/, '').replace(/\.$/, '');
const slug = (value: string, index: number) =>
	`${value.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '') || 'series'}-${index}`;
const ticks = (min: number, max: number, count: number) =>
	Array.from({ length: count + 1 }, (_, index) => min + ((max - min) * index) / count);
const expandDomain = (min: number, max: number): [number, number] =>
	min === max ? [min - 1, max + 1] : [min, max];

const seriesMeta = series.map((item, index) => ({
	...item,
	color: item.color ?? palette[index % palette.length],
	id: slug(item.label, index),
}));

const pointsFor = (item: ChartSeries) => {
	if (mode === 'curve' && item.fn) {
		const min = xDomain?.[0] ?? 0;
		const max = xDomain?.[1] ?? 10;
		return Array.from({ length: 81 }, (_, index) => {
			const x = min + ((max - min) * index) / 80;
			const y = item.fn?.(x) ?? NaN;
			return { x, y };
		}).filter((point) => finite(point.y));
	}

	return (item.values ?? []).filter(
		(point): point is ChartPoint & { x: number } => typeof point.x === 'number' && finite(point.x) && finite(point.y),
	);
};

const plottedSeries = seriesMeta.map((item) => ({ ...item, points: pointsFor(item) }));
const allPoints = plottedSeries.flatMap((item) => item.points);
const pointX = allPoints.map((point) => point.x);
const pointY = allPoints.map((point) => point.y);
const [xMin, xMax] = expandDomain(xDomain?.[0] ?? Math.min(...pointX, 0), xDomain?.[1] ?? Math.max(...pointX, 1));
const [yMin, yMax] = expandDomain(yDomain?.[0] ?? (isBar ? 0 : Math.min(...pointY, 0)), yDomain?.[1] ?? Math.max(...pointY, 1));
const scaleX = (value: number) => padding.left + ((value - xMin) / (xMax - xMin)) * plotWidth;
const scaleY = (value: number) => padding.top + plotHeight - ((value - yMin) / (yMax - yMin)) * plotHeight;
const pathFor = (points: { x: number; y: number }[]) =>
	points
		.slice()
		.sort((a, b) => a.x - b.x)
		.map((point, index) => `${index === 0 ? 'M' : 'L'} ${scaleX(point.x).toFixed(2)} ${scaleY(point.y).toFixed(2)}`)
		.join(' ');

const yTicks = ticks(yMin, yMax, 4);
const xTicks = ticks(xMin, xMax, 4);
const categories = [...new Set(seriesMeta.flatMap((item) => (item.values ?? []).map((point) => String(point.x))))];
const barSeries = seriesMeta.map((item) => ({
	...item,
	bars: (item.values ?? []).filter((point) => finite(point.y)).map((point) => ({ label: String(point.x), value: point.y })),
}));
const categoryWidth = plotWidth / Math.max(categories.length, 1);
const barWidth = (categoryWidth / Math.max(barSeries.length, 1)) * 0.72;
const animatedDataLayerClass = animateOnScroll
	? '[clip-path:inset(0_100%_0_0)] opacity-0 transition-[clip-path,opacity] delay-500 duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] motion-reduce:[clip-path:none] motion-reduce:opacity-100 motion-reduce:transition-none'
	: '';
---

<figure class="chart group/chart my-10 max-w-3xl border border-line bg-white p-4" data-chart data-chart-mode={mode} data-x-label={xLabel} data-y-label={yLabel} data-toggle-state={initialToggleState} data-has-toggle={toggle ? true : undefined} data-animate-on-scroll={animateOnScroll ? true : undefined} aria-label={title ?? 'Gráfico'}>
	<div class="mb-3 flex flex-wrap items-center justify-between gap-x-6 gap-y-2">
		{title && <figcaption class="m-0 font-sans text-[0.68rem] font-bold uppercase tracking-[0.14em] text-ink">{title}</figcaption>}
		<div class="ml-auto flex flex-wrap items-center gap-x-5 gap-y-2">
			{toggle && (
				<button
					type="button"
					class="chart-toggle relative grid min-w-40 cursor-pointer grid-cols-2 border border-line bg-soft p-[0.1rem] font-sans text-[0.68rem] uppercase tracking-[0.08em]"
					data-chart-toggle
					aria-label="Cambiar estado del gráfico"
					aria-pressed={initialToggleState === 1}
				>
					<span class:list={['pointer-events-none absolute inset-y-[0.2rem] left-[0.2rem] w-[calc(50%_-_0.2rem)] border border-line bg-white transition-transform duration-150', { 'translate-x-full': initialToggleState === 1 }]} data-toggle-indicator></span>
					<span class:list={['relative z-10 px-2 py-[0.35rem] text-center transition-colors duration-150', initialToggleState === 0 ? 'font-bold text-ink' : 'text-muted']} data-toggle-option="0">{toggle.labels[0] ?? 'A'}</span>
					<span class:list={['relative z-10 px-2 py-[0.35rem] text-center transition-colors duration-150', initialToggleState === 1 ? 'font-bold text-ink' : 'text-muted']} data-toggle-option="1">{toggle.labels[1] ?? 'B'}</span>
				</button>
			)}
			<ul class="m-0 flex list-none flex-wrap items-center gap-x-4 gap-y-1.5 p-0" aria-label="Leyenda">
				{seriesMeta.map((item) => (
					<li>
						<button type="button" class:list={['chart-legend-item inline-flex cursor-pointer items-center gap-[0.45rem] p-0 font-sans text-[0.68rem] uppercase tracking-[0.08em] transition-[opacity,filter] duration-150', { 'hidden': toggle && (item.state ?? 0) !== initialToggleState }]} data-series={item.id} data-toggle-state={item.state ?? 0}>
							<svg class="h-[0.65rem] w-[0.65rem] flex-none" viewBox="0 0 1 1" aria-hidden="true">
								<rect width="1" height="1" fill={item.color} />
							</svg>
							{item.label}
						</button>
					</li>
				))}
			</ul>
		</div>
	</div>
	<div class="relative overflow-x-auto">
		<svg class="block h-auto w-full min-w-[34rem]" viewBox={`0 0 ${width} ${height}`} role="img" aria-label={title ?? 'Gráfico'}>
			{showGrid && yTicks.map((tick) => (
				<line x1={padding.left} x2={width - padding.right} y1={scaleY(tick)} y2={scaleY(tick)} class="stroke-line [stroke-width:1]" />
			))}
			<line x1={padding.left} x2={padding.left} y1={padding.top} y2={height - padding.bottom} class="stroke-ink [stroke-width:1]" />
			<line x1={padding.left} x2={width - padding.right} y1={height - padding.bottom} y2={height - padding.bottom} class="stroke-ink [stroke-width:1]" />

			{yTicks.map((tick) => (
				<text x={padding.left - 10} y={scaleY(tick) + 4} text-anchor="end" class="fill-muted font-mono text-[10px]">{formatValue(tick)}</text>
			))}

			{isBar ? (
				<>
					{categories.map((category, categoryIndex) => (
						<text x={padding.left + categoryWidth * categoryIndex + categoryWidth / 2} y={height - padding.bottom + 24} text-anchor="middle" class="fill-muted font-mono text-[10px]">{category}</text>
					))}
					<g class:list={['chart-data-layer', animatedDataLayerClass]}>
					{barSeries.map((item, seriesIndex) => (
						<g class:list={['chart-series outline-none transition-[opacity,filter] duration-150', { 'hidden': toggle && (item.state ?? 0) !== initialToggleState }]} data-series={item.id} data-toggle-state={item.state ?? 0} tabindex="0" role="img" aria-label={item.label}>
							{item.bars.map((bar) => {
								const categoryIndex = categories.indexOf(bar.label);
								const valueY = scaleY(bar.value);
								const zeroY = scaleY(0);
								return (
									<rect
										x={padding.left + categoryWidth * categoryIndex + (categoryWidth - barWidth * barSeries.length) / 2 + seriesIndex * barWidth}
										y={Math.min(valueY, zeroY)}
										width={barWidth}
										height={Math.abs(zeroY - valueY)}
										fill={item.color}
										class="chart-bar transition-[filter] duration-150"
									/>
								);
							})}
						</g>
					))}
					</g>
				</>
			) : (
				<>
					{xTicks.map((tick) => (
						<text x={scaleX(tick)} y={height - padding.bottom + 24} text-anchor="middle" class="fill-muted font-mono text-[10px]">{formatValue(tick)}</text>
					))}
					<g class:list={['chart-data-layer', animatedDataLayerClass]}>
					{plottedSeries.map((item) => (
						<g class:list={['chart-series outline-none transition-[opacity,filter] duration-150', { 'hidden': toggle && (item.state ?? 0) !== initialToggleState }]} data-series={item.id} data-toggle-state={item.state ?? 0} tabindex="0" role="img" aria-label={item.label}>
							{mode !== 'scatter' && (
								<>
									<path
										d={pathFor(item.points)}
										fill="none"
										stroke="transparent"
										stroke-width="16"
										stroke-linecap="round"
										stroke-linejoin="round"
										style="pointer-events: stroke;"
									/>
									<path
										d={pathFor(item.points)}
										fill="none"
										stroke={item.color}
										class="chart-line [stroke-width:1] transition-[stroke-width] duration-150"
									/>
								</>
							)}
							{(mode === 'line' || mode === 'scatter') && showPoints && item.points.map((point) => (
								<circle
									cx={scaleX(point.x)}
									cy={scaleY(point.y)}
									r="3"
									fill={item.color}
									stroke="transparent"
									stroke-width="10"
									style="pointer-events: all;"
									class:list={['chart-point stroke-[10px] [paint-order:stroke_fill] transition-[r] duration-150', { '[r:5px]': mode === 'scatter' }]}
									data-chart-point={showTooltip ? true : undefined}
									data-label={item.label}
									data-point-label={point.label}
									data-x={point.x}
									data-y={point.y}
									tabindex="0"
									aria-label={`${item.label}: x ${point.x}, y ${point.y}`}
								/>
							))}
						</g>
					))}
					</g>
				</>
			)}

			{xLabel && <text x={padding.left + plotWidth / 2} y={height - 8} text-anchor="middle" class="fill-muted font-sans text-[11px]">{xLabel}</text>}
			{yLabel && <text x="14" y={padding.top + plotHeight / 2} text-anchor="middle" transform={`rotate(-90 14 ${padding.top + plotHeight / 2})`} class="fill-muted font-sans text-[11px]">{yLabel}</text>}
		</svg>
		{showTooltip && <div class="chart-tooltip pointer-events-none fixed z-20 max-w-72 whitespace-pre-line border border-line bg-white px-[0.8rem] py-[0.65rem] font-sans text-[0.68rem] leading-[1.4] text-ink shadow-[0_8px_24px_rgb(0_0_0/0.12)] [overflow-wrap:anywhere]" data-chart-tooltip role="status" aria-live="polite" hidden></div>}
	</div>
</figure>

<script>
	const charts = document.querySelectorAll('[data-chart]');

	charts.forEach((chart) => {
		const objects = Array.from(chart.querySelectorAll('[data-series]'));
		const points = Array.from(chart.querySelectorAll('[data-chart-point]'));
		const tooltip = chart.querySelector('[data-chart-tooltip]');
		const toggleButton = chart.querySelector('[data-chart-toggle]');
		const toggleIndicator = chart.querySelector('[data-toggle-indicator]');
		const toggleOptions = Array.from(chart.querySelectorAll('[data-toggle-option]'));
		const svg = chart.querySelector('svg');

		let currentHighlight: string | null = null;
		let highlightTimer: any = null;

		const setHighlight = (id: string) => {
			if (highlightTimer) {
				clearTimeout(highlightTimer);
				highlightTimer = null;
			}
			if (currentHighlight === id) return;
			currentHighlight = id;

			objects.forEach((object) => {
				const match = object.dataset.series === id;
				object.classList.toggle('opacity-[0.16]', !match);
				object.querySelectorAll('.chart-line').forEach((line) => {
					line.classList.toggle('[stroke-width:1]', !match);
					line.classList.toggle('[stroke-width:2.5]', match);
				});
				if (chart.dataset.chartMode !== 'scatter') {
					object.querySelectorAll('.chart-point').forEach((point) => point.classList.toggle('[r:4.5px]', match));
				}
				object.querySelectorAll('.chart-bar').forEach((bar) => bar.classList.toggle('brightness-85', match));
			});
		};

		const clearHighlight = () => {
			if (highlightTimer) {
				clearTimeout(highlightTimer);
				highlightTimer = null;
			}
			if (!currentHighlight) return;
			currentHighlight = null;

			objects.forEach((object) => {
				object.classList.remove('opacity-[0.16]');
				object.querySelectorAll('.chart-line').forEach((line) => {
					line.classList.remove('[stroke-width:2.5]');
					line.classList.add('[stroke-width:1]');
				});
				object.querySelectorAll('.chart-point').forEach((point) => point.classList.remove('[r:4.5px]'));
				object.querySelectorAll('.chart-bar').forEach((bar) => bar.classList.remove('brightness-85'));
			});
		};

		const scheduleClearHighlight = () => {
			if (highlightTimer) clearTimeout(highlightTimer);
			highlightTimer = setTimeout(() => {
				clearHighlight();
			}, 75);
		};

		if (toggleButton) {
			let state = Number(chart.dataset.toggleState ?? 0);
			const applyToggle = () => {
				chart.dataset.toggleState = String(state);
				toggleButton.setAttribute('aria-pressed', String(state === 1));
				toggleIndicator?.classList.toggle('translate-x-full', state === 1);
				toggleOptions.forEach((option) => {
					const isActive = Number(option.dataset.toggleOption) === state;
					option.classList.toggle('font-bold', isActive);
					option.classList.toggle('text-ink', isActive);
					option.classList.toggle('text-muted', !isActive);
				});
				objects.forEach((object) => {
					object.classList.toggle('hidden', Number(object.dataset.toggleState ?? 0) !== state);
				});
			};

			toggleButton.addEventListener('click', () => {
				state = state === 0 ? 1 : 0;
				applyToggle();
			});
			applyToggle();
		}

		objects.forEach((object) => {
			object.addEventListener('pointerenter', () => setHighlight(object.dataset.series ?? ''));
			object.addEventListener('pointerleave', scheduleClearHighlight);
			object.addEventListener('focus', () => setHighlight(object.dataset.series ?? ''));
			object.addEventListener('blur', clearHighlight);
		});

		svg?.addEventListener('pointerleave', scheduleClearHighlight);

		if (tooltip) {
			let tooltipTimer: any = null;

			const cancelHideTooltip = () => {
				if (tooltipTimer) {
					clearTimeout(tooltipTimer);
					tooltipTimer = null;
				}
			};

			const hideTooltip = () => {
				cancelHideTooltip();
				tooltip.hidden = true;
			};

			const scheduleHideTooltip = () => {
				if (tooltipTimer) clearTimeout(tooltipTimer);
				tooltipTimer = setTimeout(() => {
					tooltip.hidden = true;
					tooltipTimer = null;
				}, 75);
			};

			const tooltipText = (point: HTMLElement | SVGElement) => {
				const xLabel = chart.dataset.xLabel ?? 'x';
				const yLabel = chart.dataset.yLabel ?? 'y';
				return [
					point.dataset.label,
					point.dataset.pointLabel,
					`${xLabel}: ${point.dataset.x}`,
					`${yLabel}: ${point.dataset.y}`,
				].filter(Boolean).join('\n');
			};

			const moveTooltip = (point: HTMLElement | SVGElement, event: MouseEvent | PointerEvent) => {
				cancelHideTooltip();
				const text = tooltipText(point);
				if (tooltip.textContent !== text) {
					tooltip.textContent = text;
				}
				tooltip.hidden = false;
				const tooltipBox = tooltip.getBoundingClientRect();
				const left = Math.min(event.clientX + 14, window.innerWidth - tooltipBox.width - 8);
				const top = Math.min(event.clientY + 14, window.innerHeight - tooltipBox.height - 8);
				tooltip.style.left = `${Math.max(8, left)}px`;
				tooltip.style.top = `${Math.max(8, top)}px`;
			};

			points.forEach((point) => {
				point.addEventListener('pointerenter', (event) => moveTooltip(point, event));
				point.addEventListener('pointermove', (event) => moveTooltip(point, event));
				point.addEventListener('pointerleave', scheduleHideTooltip);
				point.addEventListener('focus', () => {
					cancelHideTooltip();
					tooltip.hidden = false;
					tooltip.textContent = tooltipText(point);
				});
				point.addEventListener('blur', hideTooltip);
			});

			svg?.addEventListener('pointerleave', scheduleHideTooltip);
		}
	});

	const revealChart = (chart) => {
		chart.querySelectorAll('.chart-data-layer').forEach((layer) => {
			layer.classList.remove('[clip-path:inset(0_100%_0_0)]', 'opacity-0', 'delay-500');
			layer.classList.add('[clip-path:inset(0)]', 'opacity-100');
		});
	};

	document.querySelectorAll('[data-animate-on-scroll]').forEach((chart) => {
		if (!('IntersectionObserver' in window)) {
			revealChart(chart);
			return;
		}

		const observer = new IntersectionObserver(([entry]) => {
			if (!entry.isIntersecting) return;
			revealChart(chart);
			observer.disconnect();
		}, { threshold: 0.2 });
		observer.observe(chart);
	});
</script>
