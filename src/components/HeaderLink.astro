---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;
const pathname = Astro.url.pathname.replace(import.meta.env.BASE_URL, '');
const subpath = pathname.match(/[^\/]+/g);
const currentPath = '/' + (subpath?.[0] || '');
const isActive = href === pathname || href === currentPath || (href === '/' && currentPath === '/blog');
---

<a
	href={href}
	class:list={[
		className,
		'group relative mt-3 inline-flex self-start items-center gap-2 leading-[1.4] text-inherit no-underline first:mt-0 hover:text-ink md:mt-[0.35rem]',
		{ 'text-ink': isActive },
	]}
	{...props}
>
	{isActive && (
		<span
			class="hidden h-[0.425em] w-[0.425em] rounded-full bg-ink md:absolute md:-left-4 md:top-1/2 md:block md:-translate-y-1/2"
			aria-hidden="true"
		></span>
	)}
	<span class:list={[
		'relative isolate inline-block overflow-hidden px-0 before:absolute before:inset-0 before:-z-10 before:hidden before:origin-left before:scale-x-0 before:bg-ink before:transition-transform before:duration-150 group-hover:text-paper md:px-[0.15em] md:before:block md:group-hover:before:scale-x-100',
		{ 'font-bold': isActive },
	]}>
		<slot />
	</span>
</a>
