---
const today = new Date();
---

<footer class="w-full shrink-0 border-t border-line pt-6 font-sans text-xs uppercase tracking-[0.1em] text-muted md:w-[200px] md:basis-[200px]" aria-label="Footer">
	<div class="flex flex-col gap-3">
		<div class="flex w-full items-center justify-between">
			<div class="flex items-center gap-3" aria-label="Social links">
				<a class="transition-colors hover:text-ink" href="https://github.com/43curious" aria-label="GitHub" rel="noreferrer" target="_blank">
					<svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
						<path d="M12 2C6.48 2 2 6.58 2 12.26c0 4.53 2.87 8.37 6.84 9.73.5.1.68-.22.68-.49l-.01-1.9c-2.78.62-3.37-1.22-3.37-1.22-.45-1.19-1.11-1.5-1.11-1.5-.91-.64.07-.63.07-.63 1 .07 1.53 1.06 1.53 1.06.9 1.57 2.35 1.12 2.92.86.09-.67.35-1.12.63-1.38-2.22-.26-4.56-1.14-4.56-5.06 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.71 0 0 .84-.27 2.75 1.05A9.3 9.3 0 0 1 12 6.98c.85 0 1.7.12 2.5.34 1.9-1.32 2.74-1.05 2.74-1.05.55 1.41.2 2.45.1 2.71.64.72 1.03 1.63 1.03 2.75 0 3.93-2.34 4.8-4.57 5.05.36.32.68.94.68 1.9l-.01 2.82c0 .27.18.59.69.49A10.16 10.16 0 0 0 22 12.26C22 6.58 17.52 2 12 2Z" />
					</svg>
				</a>
				<a class="transition-colors hover:text-ink" href="/rss.xml" aria-label="RSS feed">
					<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<path d="M4 11a9 9 0 0 1 9 9" />
						<path d="M4 4a16 16 0 0 1 16 16" />
						<circle cx="5" cy="19" r="1" fill="currentColor" stroke="none" />
					</svg>
				</a>
			</div>

			<button
				type="button"
				class="theme-toggle relative grid w-14 cursor-pointer grid-cols-2 border border-line bg-soft p-[0.1rem]"
				data-theme-toggle
				role="switch"
				aria-checked="false"
				aria-label="Cambiar tema claro u oscuro"
			>
				<span
					class="theme-indicator pointer-events-none absolute inset-y-[0.15rem] left-[0.15rem] w-[calc(50%_-_0.15rem)] border border-line bg-paper transition-transform duration-150 motion-reduce:transition-none"
				></span>
				<span
					class="theme-label-light relative z-10 flex items-center justify-center py-1 text-center text-ink transition-colors duration-150"
					data-theme-set="light"
					aria-label="Modo claro"
				>
					<svg class="h-3.5 w-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<circle cx="12" cy="12" r="4" />
						<path d="M12 2v2" />
						<path d="M12 20v2" />
						<path d="m4.93 4.93 1.41 1.41" />
						<path d="m17.66 17.66 1.41 1.41" />
						<path d="M2 12h2" />
						<path d="M20 12h2" />
						<path d="m6.34 17.66-1.41 1.41" />
						<path d="m19.07 4.93-1.41 1.41" />
					</svg>
				</span>
				<span
					class="theme-label-dark relative z-10 flex items-center justify-center py-1 text-center text-muted transition-colors duration-150"
					data-theme-set="dark"
					aria-label="Modo oscuro"
				>
					<svg class="h-3.5 w-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" />
					</svg>
				</span>
			</button>
		</div>

		<span class="text-ink">&copy; {today.getFullYear()}</span>
	</div>
</footer>

<script>
	const themeToggle = document.querySelector('[data-theme-toggle]');
	const mediaQuery = window.matchMedia('(prefers-color-scheme: dark)');

	const applyTheme = (theme: string, persist = true) => {
		const isDark = theme === 'dark';
		document.documentElement.classList.toggle('dark', isDark);
		document.documentElement.classList.toggle('light', !isDark);
		themeToggle?.setAttribute('aria-checked', String(isDark));
		if (persist) {
			localStorage.setItem('theme', theme);
		}
	};

	const initTheme = () => {
		const isDark = document.documentElement.classList.contains('dark') ||
			(!document.documentElement.classList.contains('light') && mediaQuery.matches);
		themeToggle?.setAttribute('aria-checked', String(isDark));
	};

	initTheme();
	document.addEventListener('astro:after-swap', initTheme);

	mediaQuery.addEventListener('change', (e) => {
		localStorage.removeItem('theme');
		applyTheme(e.matches ? 'dark' : 'light', false);
	});

	themeToggle?.addEventListener('click', (event) => {
		const target = event.target instanceof Element ? event.target.closest('[data-theme-set]') : null;
		const requestedTheme = target?.getAttribute('data-theme-set');
		const currentIsDark = document.documentElement.classList.contains('dark') ||
			(!document.documentElement.classList.contains('light') && mediaQuery.matches);
		const nextTheme = requestedTheme || (currentIsDark ? 'light' : 'dark');
		applyTheme(nextTheme, true);
	});
</script>
