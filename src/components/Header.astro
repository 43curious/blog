---
import HeaderLink from './HeaderLink.astro';

const links = [
	{ href: '/', label: 'Home' },
	{ href: '/tools', label: 'Tools' },
	{ href: '/projects', label: 'Projects' },
	{ href: '/about', label: 'About' },
];
---

<header class="w-full shrink-0 font-mono text-sm lg:w-32">
	<nav class="hidden flex-col items-start text-muted uppercase lg:flex" aria-label="Primary navigation">
		{links.map((link) => <HeaderLink href={link.href}>{link.label}</HeaderLink>)}
	</nav>

	<details class="group lg:hidden">
		<summary class="flex cursor-pointer list-none items-center justify-between border border-line bg-white p-4 text-muted uppercase marker:hidden [&::-webkit-details-marker]:hidden">
			<span>Menu</span>
			<span class="relative h-4 w-5" aria-hidden="true">
				<span class="absolute left-0 top-0 h-px w-full bg-ink transition-transform group-open:translate-y-[7px] group-open:rotate-45"></span>
				<span class="absolute left-0 top-[7px] h-px w-full bg-ink transition-opacity group-open:opacity-0"></span>
				<span class="absolute bottom-0 left-0 h-px w-full bg-ink transition-transform group-open:-translate-y-[7px] group-open:-rotate-45"></span>
			</span>
		</summary>
		<nav class="flex flex-col items-start border-x border-b border-line bg-white p-4 text-muted uppercase" aria-label="Mobile navigation">
			{links.map((link) => <HeaderLink href={link.href}>{link.label}</HeaderLink>)}
		</nav>
	</details>
</header>
