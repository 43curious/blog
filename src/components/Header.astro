---
import HeaderLink from './HeaderLink.astro';

const links = [
	{ href: '/', label: 'Inicio' },
	{ href: '/resources', label: 'Recursos' },
	{ href: '/projects', label: 'Proyectos' },
];

const pathname = Astro.url.pathname.replace(import.meta.env.BASE_URL, '');
const subpath = pathname.match(/[^\/]+/g);
const currentPath = '/' + (subpath?.[0] || '');
const currentLink = links.find((link) => link.href === pathname || link.href === currentPath) ?? links[0];
---

<header class="relative z-50 w-full shrink-0 font-sans text-sm md:sticky md:top-20 md:h-fit md:w-[200px] md:basis-[200px]">
	<nav class="hidden flex-col items-start text-muted uppercase md:flex" aria-label="Primary navigation">
		{links.map((link) => <HeaderLink href={link.href}>{link.label}</HeaderLink>)}
	</nav>

	<details class="group relative md:hidden">
		<summary class="flex cursor-pointer list-none items-center justify-between border border-line bg-white px-4 py-4 text-muted uppercase marker:hidden [&::-webkit-details-marker]:hidden">
			<span class="inline-flex items-center text-sm text-ink">
				<span>{currentLink.label}</span>
			</span>
			<span class="relative ml-4 h-4 w-5 shrink-0" aria-hidden="true">
				<span class="absolute left-0 top-0 h-px w-full bg-ink transition-transform group-open:translate-y-[7px] group-open:rotate-45"></span>
				<span class="absolute left-0 top-[7px] h-px w-full bg-ink transition-opacity group-open:opacity-0"></span>
				<span class="absolute bottom-0 left-0 h-px w-full bg-ink transition-transform group-open:-translate-y-[7px] group-open:-rotate-45"></span>
			</span>
		</summary>
		<nav class="absolute left-0 right-0 top-full z-[60] mt-2 flex flex-col items-start border border-line bg-white p-5 text-base text-muted uppercase shadow-[0_14px_30px_rgb(0_0_0/0.06)]" aria-label="Mobile navigation">
			{links.map((link) => <HeaderLink href={link.href}>{link.label}</HeaderLink>)}
		</nav>
	</details>
</header>
