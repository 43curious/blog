---
import AudioRouting from './AudioRouting.astro';
import '../styles/shortcut-animations.css';

interface Props {
	mode: 'workspaces' | 'layouts' | 'focus' | 'audio';
}

const { mode } = Astro.props;
const hasTwoWindows = mode === 'layouts' || mode === 'focus';
const { shortcuts, targets, description, label } = {
	workspaces: {
		shortcuts: ['1', '2', '3'],
		targets: ['Rex', 'Zen', 'Calendario'],
		description: 'Ctrl + 1 → Rex · Ctrl + 2 → Zen · Ctrl + 3 → Calendario.',
		label: 'Aplicación',
	},
	layouts: {
		shortcuts: ['Q', 'W'],
		targets: ['Rex', 'Zen'],
		description: 'Ctrl + Q → mosaico · Ctrl + W → acordeón.',
		label: 'Distribución',
	},
	focus: {
		shortcuts: ['J', 'K'],
		targets: ['Rex', 'Zen'],
		description: 'Ctrl + J → foco a la izquierda · Ctrl + K → foco a la derecha.',
		label: 'Foco',
	},
	audio: {
		shortcuts: ['E', 'R'],
		targets: ['EarPods', 'Altavoces del MacBook Pro'],
		description: 'Ctrl + E → EarPods · Ctrl + R → altavoces del MacBook Pro.',
		label: 'Salida de audio',
	},
}[mode];
---

<figure class="window-demo" data-window-management data-mode={mode} data-steps={shortcuts.length} aria-label={description}>
	<div class="demo-stage" aria-hidden="true">
		<div class="demo-half">
			<span class="half-label">Combinación</span>
			<div class="key-combo">
				<kbd class="keycap modifier-key" data-modifier>ctrl</kbd>
				<span class="key-plus">+</span>
				<kbd class="keycap combo-key" data-keycap>
					{shortcuts.map((key, index) => (
						<span class="key-value" style={`--phase: ${(index - shortcuts.length) * 2.7}s`} data-key-value>{key}</span>
					))}
				</kbd>
			</div>
		</div>
		<span class="demo-arrow">→</span>
		<div class="demo-half application-half">
			<span class="half-label">{label}</span>
			{mode === 'audio' ? (
				<AudioRouting devices={targets} />
			) : (
				<div class:list={['application-stage', { 'layout-stage': hasTwoWindows, 'focus-stage': mode === 'focus' }]}>
					{targets.map((name, index) => (
						<div class="application-window" style={`--phase: ${(index - targets.length) * 2.7}s`} data-application>{name}</div>
					))}
				</div>
			)}
		</div>
	</div>
	<figcaption>{description}</figcaption>
</figure>

<style>
	.window-demo {
		--shortcut-cycle: 5.4s;
		--target-animation: shortcut-target-two;
		--label-animation: shortcut-label-two;
		margin: 2rem 0;
		max-width: 48rem;
	}

	.window-demo[data-steps='3'] {
		--shortcut-cycle: 8.1s;
		--target-animation: shortcut-target-three;
		--label-animation: shortcut-label-three;
	}

	.demo-stage {
		position: relative;
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		min-height: 14rem;
	}

	.demo-half {
		display: flex;
		min-width: 0;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 1.5rem;
		padding: 1.5rem;
	}

	.half-label {
		color: var(--color-muted);
		font-size: 0.6rem;
		line-height: 1;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.key-combo {
		display: flex;
		height: 6rem;
		align-items: center;
		gap: 0.65rem;
	}

	.window-demo .keycap {
		display: inline-flex;
		position: relative;
		align-items: center;
		justify-content: center;
		width: 3rem;
		height: 3rem;
		padding: 0;
		border: 1px solid var(--color-line);
		border-radius: 0.25rem;
		background: var(--color-paper);
		box-shadow: 0 4px 0 var(--color-line);
		color: var(--color-ink);
		font-family: var(--font-mono);
		font-size: 1rem;
		line-height: 1;
		animation: shortcut-letter-press 2.7s ease infinite;
	}

	.window-demo .modifier-key {
		width: 4.5rem;
		font-size: 0.85rem;
		animation-name: shortcut-modifier-press;
	}

	/* Press Ctrl at 0.5s and the letter at 0.64s; both return by 1.34s. */
	@keyframes shortcut-modifier-press {
		0%, 18.518519%, 49.62963%, 100% { transform: translateY(0); background: var(--color-paper); color: var(--color-ink); border-color: var(--color-line); box-shadow: 0 4px 0 var(--color-line); }
		22.962963%, 45.185185% { transform: translateY(4px); background: var(--color-focus); color: #fff; border-color: var(--color-focus); box-shadow: 0 0 0 var(--color-line); }
	}

	@keyframes shortcut-letter-press {
		0%, 23.703704%, 49.62963%, 100% { transform: translateY(0); background: var(--color-paper); color: var(--color-ink); border-color: var(--color-line); box-shadow: 0 4px 0 var(--color-line); }
		28.148148%, 45.185185% { transform: translateY(4px); background: var(--color-focus); color: #fff; border-color: var(--color-focus); box-shadow: 0 0 0 var(--color-line); }
	}

	.key-plus {
		color: var(--color-muted);
		font-family: var(--font-mono);
		font-size: 0.8rem;
	}

	.key-value {
		position: absolute;
		opacity: 0;
		animation: var(--label-animation) var(--shortcut-cycle) steps(1, end) infinite;
		animation-delay: var(--phase);
	}

	.demo-arrow {
		position: absolute;
		top: calc(50% + 1rem);
		left: 50%;
		z-index: 1;
		transform: translate(-50%, -50%);
		padding: 0.2rem;
		color: var(--color-muted);
		font-size: 1.2rem;
		line-height: 1;
	}

	.application-stage {
		position: relative;
		width: 100%;
		max-width: 13rem;
		height: 6rem;
		background: var(--color-focus);
	}

	.application-window {
		position: absolute;
		inset: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		background: var(--color-focus);
		color: #fff;
		font-size: 1rem;
		font-weight: 500;
		opacity: var(--shortcut-active);
		transform: translateY(calc((1 - var(--shortcut-active)) * 0.4rem));
		animation: var(--target-animation) var(--shortcut-cycle) linear infinite;
		animation-delay: var(--phase);
	}

	.window-demo[data-mode='audio'] .key-combo {
		height: 9rem;
	}

	.layout-stage {
		background: transparent;
	}

	.layout-stage .application-window {
		inset: 0 auto 0 0;
		width: calc(50% - 0.25rem);
		opacity: 1;
		transform: none;
		font-size: 0.8rem;
	}

	.layout-stage .application-window:nth-child(2) {
		left: calc(50% + 0.25rem);
	}

	.window-demo[data-mode='layouts'] .application-window {
		animation: accordion-layout var(--shortcut-cycle) ease infinite;
	}

	.window-demo[data-mode='layouts'] .application-window:nth-child(2) {
		animation-name: accordion-front;
	}

	/* Ctrl+W applies at 3.56s; Ctrl+Q restores tiles at 0.86s of the next loop. */
	@keyframes accordion-layout {
		0%, 15.925926%, 72.592593%, 100% { width: calc(100% - 2rem); opacity: 0.55; }
		22.592593%, 65.925926% { width: calc(50% - 0.375rem); opacity: 1; }
	}

	@keyframes accordion-front {
		0%, 15.925926%, 72.592593%, 100% { left: 2rem; width: calc(100% - 2rem); }
		22.592593%, 65.925926% { left: calc(50% + 0.375rem); width: calc(50% - 0.375rem); }
	}

	.focus-stage .application-window {
		opacity: calc(0.35 + 0.65 * var(--shortcut-active));
	}

	figcaption {
		margin-top: 0.65rem;
		color: var(--color-muted);
		font-size: 0.7rem;
		line-height: 1.6;
	}

	@media (max-width: 480px) {
		.demo-stage { min-height: 12rem; }
		.demo-half { gap: 1.25rem; padding: 1rem; }
		.key-combo { gap: 0.4rem; }
		.window-demo .keycap { width: 2.25rem; height: 2.5rem; font-size: 0.9rem; }
		.window-demo .modifier-key { width: 3.25rem; font-size: 0.75rem; }
		.application-window { font-size: 0.8rem; }
		.layout-stage .application-window { font-size: 0.7rem; }
	}

	@media (max-width: 360px) {
		.demo-half { padding-inline: 0.5rem; }
		.key-combo { gap: 0.35rem; }
		.window-demo .modifier-key { width: 3rem; }
		.window-demo .combo-key { width: 2rem; }
	}

	@media (prefers-reduced-motion: reduce) {
		.window-demo .keycap, .window-demo .key-value, .window-demo .application-window { animation: none !important; }
		.key-value:first-child { opacity: 1; }
		.application-window { --shortcut-active: 0; }
		.application-window:first-child { --shortcut-active: 1; }
		.window-demo[data-mode='layouts'] .application-window { width: calc(50% - 0.375rem); opacity: 1; }
		.window-demo[data-mode='layouts'] .application-window:nth-child(2) { left: calc(50% + 0.375rem); }
	}
</style>
