---
import AudioRouting from './AudioRouting.astro';

interface Props {
	mode: 'workspaces' | 'layouts' | 'focus' | 'audio';
}

const { mode } = Astro.props;
const hasTwoWindows = mode === 'layouts' || mode === 'focus';
const { shortcuts, targets, description, label } = {
	workspaces: {
		shortcuts: ['1', '2', '3'],
		targets: ['Rex', 'Zen', 'Calendario'],
		description: 'Ctrl + 1 → Rex · Ctrl + 2 → Zen · Ctrl + 3 → Calendario.',
		label: 'Aplicación',
	},
	layouts: {
		shortcuts: ['Q', 'W'],
		targets: ['Rex', 'Zen'],
		description: 'Ctrl + Q → mosaico · Ctrl + W → acordeón.',
		label: 'Distribución',
	},
	focus: {
		shortcuts: ['J', 'K'],
		targets: ['Rex', 'Zen'],
		description: 'Ctrl + J → foco a la izquierda · Ctrl + K → foco a la derecha.',
		label: 'Foco',
	},
	audio: {
		shortcuts: ['E', 'R'],
		targets: ['EarPods', 'Altavoces del MacBook Pro'],
		description: 'Ctrl + E → EarPods · Ctrl + R → altavoces del MacBook Pro.',
		label: 'Salida de audio',
	},
}[mode];
---

<figure class="window-demo" data-window-management data-mode={mode} data-layout="tiles" aria-label={description}>
	<div class="demo-stage" aria-hidden="true">
		<div class="demo-half">
			<span class="half-label">Combinación</span>
			<div class="key-combo">
				<kbd class="keycap modifier-key" data-modifier>ctrl</kbd>
				<span class="key-plus">+</span>
				<kbd class="keycap combo-key" data-keycap>
					{shortcuts.map((key, index) => (
						<span class:list={['key-value', { 'is-current': index === 0 }]} data-key-value>{key}</span>
					))}
				</kbd>
			</div>
		</div>
		<span class="demo-arrow">→</span>
		<div class="demo-half application-half">
			<span class="half-label">{label}</span>
			{mode === 'audio' ? (
				<AudioRouting devices={targets} />
			) : (
				<div class:list={['application-stage', { 'layout-stage': hasTwoWindows, 'focus-stage': mode === 'focus' }]}>
					{targets.map((name, index) => (
						<div class:list={['application-window', { 'is-current': index === 0 }]} data-application>{name}</div>
					))}
				</div>
			)}
		</div>
	</div>
	<figcaption>{description}</figcaption>
</figure>

<script>
	// Change the key after its release transition finishes. Loop only while visible.
	document.querySelectorAll<HTMLElement>('[data-window-management]').forEach((demo) => {
		const modifier = demo.querySelector<HTMLElement>('[data-modifier]');
		const keycap = demo.querySelector<HTMLElement>('[data-keycap]');
		const keys = Array.from(demo.querySelectorAll<HTMLElement>('[data-key-value]'));
		const applications = Array.from(demo.querySelectorAll<HTMLElement>('[data-application]'));
		const motionPreference = window.matchMedia('(prefers-reduced-motion: reduce)');
		let currentStep = 0;
		let appliedStep = 0;
		let inView = false;
		let playing = false;
		let pendingStep: number | undefined;
		let loopTimer: number | undefined;
		let phaseTimers: number[] = [];

		const selectKey = (step: number) => {
			keys.forEach((key, index) => key.classList.toggle('is-current', index === step));
		};

		const releaseKeys = () => {
			modifier?.classList.remove('is-pressed');
			keycap?.classList.remove('is-pressed');
		};

		keycap?.addEventListener('transitionend', (event) => {
			if (!keycap || event.target !== keycap || event.propertyName !== 'transform') return;
			if (keycap.classList.contains('is-pressed') || pendingStep === undefined) return;
			currentStep = pendingStep;
			pendingStep = undefined;
			selectKey(currentStep);
		});

		const stop = () => {
			window.clearTimeout(loopTimer);
			phaseTimers.forEach(window.clearTimeout);
			phaseTimers = [];
			playing = false;
			pendingStep = undefined;
			releaseKeys();
			currentStep = appliedStep;
			selectKey(currentStep);
		};

		const advance = () => {
			const step = currentStep;
			const previewDelay = 500;
			phaseTimers = [
				window.setTimeout(() => modifier?.classList.add('is-pressed'), previewDelay),
				window.setTimeout(() => keycap?.classList.add('is-pressed'), previewDelay + 140),
				window.setTimeout(() => {
					appliedStep = step;
					if (demo.dataset.mode === 'layouts') {
						demo.dataset.layout = step === 0 ? 'tiles' : 'accordion';
					} else {
						applications.forEach((app, index) => app.classList.toggle('is-current', index === step));
					}
				}, previewDelay + 360),
				window.setTimeout(() => {
					pendingStep = (step + 1) % keys.length;
					releaseKeys();
				}, previewDelay + 720),
			];
			loopTimer = window.setTimeout(advance, 2700);
		};

		const updatePlayback = () => {
			if (!inView || document.hidden || motionPreference.matches) {
				stop();
			} else if (!playing) {
				playing = true;
				loopTimer = window.setTimeout(advance, 700);
			}
		};

		const observer = new IntersectionObserver(([entry]) => {
			inView = entry.intersectionRatio >= 0.25;
			updatePlayback();
		}, { threshold: 0.25 });
		observer.observe(demo);
		motionPreference.addEventListener('change', updatePlayback);
		document.addEventListener('visibilitychange', updatePlayback);
	});
</script>

<style>
	.window-demo {
		margin: 2rem 0;
		max-width: 48rem;
	}

	.demo-stage {
		position: relative;
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		min-height: 14rem;
	}

	.demo-half {
		display: flex;
		min-width: 0;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 1.5rem;
		padding: 1.5rem;
	}

	.half-label {
		color: var(--color-muted);
		font-size: 0.6rem;
		line-height: 1;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.key-combo {
		display: flex;
		height: 6rem;
		align-items: center;
		gap: 0.65rem;
	}

	.window-demo .keycap {
		display: inline-flex;
		position: relative;
		align-items: center;
		justify-content: center;
		width: 3rem;
		height: 3rem;
		padding: 0;
		border: 1px solid var(--color-line);
		border-radius: 0.25rem;
		background: var(--color-paper);
		box-shadow: 0 4px 0 var(--color-line);
		color: var(--color-ink);
		font-family: var(--font-mono);
		font-size: 1rem;
		line-height: 1;
		transition: transform 120ms ease, box-shadow 120ms ease, background 120ms ease, color 120ms ease, border-color 120ms ease;
	}

	.window-demo .modifier-key {
		width: 4.5rem;
		font-size: 0.85rem;
	}

	.window-demo .keycap.is-pressed {
		transform: translateY(4px);
		border-color: var(--color-focus);
		background: var(--color-focus);
		box-shadow: 0 0 0 var(--color-line);
		color: #fff;
	}

	.key-plus {
		color: var(--color-muted);
		font-family: var(--font-mono);
		font-size: 0.8rem;
	}

	.key-value {
		position: absolute;
		opacity: 0;
	}

	.key-value.is-current {
		opacity: 1;
	}

	.demo-arrow {
		position: absolute;
		top: calc(50% + 1rem);
		left: 50%;
		z-index: 1;
		transform: translate(-50%, -50%);
		padding: 0.2rem;
		color: var(--color-muted);
		font-size: 1.2rem;
		line-height: 1;
	}

	.application-stage {
		position: relative;
		width: 100%;
		max-width: 13rem;
		height: 6rem;
		background: var(--color-focus);
	}

	.application-window {
		position: absolute;
		inset: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		background: var(--color-focus);
		color: #fff;
		font-size: 1rem;
		font-weight: 500;
		opacity: 0;
		transform: translateY(0.4rem);
		transition: opacity 260ms ease, transform 260ms ease;
	}

	.application-window.is-current {
		opacity: 1;
		transform: translateY(0);
	}

	.window-demo[data-mode='audio'] .key-combo {
		height: 9rem;
	}

	.layout-stage {
		background: transparent;
	}

	.layout-stage .application-window {
		inset: 0 auto 0 0;
		width: calc(50% - 0.25rem);
		opacity: 1;
		transform: none;
		font-size: 0.8rem;
		transition: left 360ms ease, width 360ms ease, opacity 360ms ease;
	}

	.layout-stage .application-window:nth-child(2) {
		left: calc(50% + 0.25rem);
	}

	.window-demo[data-layout='accordion'] .layout-stage .application-window {
		width: calc(100% - 1rem);
	}

	.window-demo[data-layout='accordion'] .layout-stage .application-window:nth-child(2) {
		left: 1rem;
	}

	.window-demo[data-layout='accordion'] .layout-stage .application-window:first-child {
		opacity: 0.55;
	}

	.focus-stage .application-window {
		opacity: 0.35;
	}

	.focus-stage .application-window.is-current {
		opacity: 1;
	}

	figcaption {
		margin-top: 0.65rem;
		color: var(--color-muted);
		font-size: 0.7rem;
		line-height: 1.6;
	}

	@media (max-width: 480px) {
		.demo-stage { min-height: 12rem; }
		.demo-half { gap: 1.25rem; padding: 1rem; }
		.key-combo { gap: 0.4rem; }
		.window-demo .keycap { width: 2.25rem; height: 2.5rem; font-size: 0.9rem; }
		.window-demo .modifier-key { width: 3.25rem; font-size: 0.75rem; }
		.application-window { font-size: 0.8rem; }
		.layout-stage .application-window { font-size: 0.7rem; }
	}

	@media (prefers-reduced-motion: reduce) {
		.window-demo .keycap, .window-demo .application-window { transition: none; }
	}
</style>
